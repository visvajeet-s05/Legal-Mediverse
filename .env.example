# Application mode: test | development | testnet | production
APP_ENV=development

# Database Configuration. Use a local secret manager or untracked .env file
# for non-placeholder credentials.
DATABASE_URL=mysql+aiomysql://username:password@127.0.0.1:3306/legal_mediverse

# Security & Session Settings
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
GUEST_SESSION_EXPIRE_MINUTES=1440

# LLM Providers Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=

# Redis Pub/Sub Configuration
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LiveKit (Real-time Audio) Configuration
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Web3 Configuration. Never commit a private key.
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
WEB3_PROVIDER_URL=https://rpc-amoy.polygon.technology
WEB3_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
PRIVATE_KEY=
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_ORACLE_ADDRESS=
NEXT_PUBLIC_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CHAIN_ID=80002

# Object storage. Keep provider credentials in the deployment secret store.
OBJECT_STORAGE_PROVIDER=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
