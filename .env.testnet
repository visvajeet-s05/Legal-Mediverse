# Testnet configuration template. Copy values into an untracked deployment
# environment after a verified Amoy deployment; do not store private keys here.
APP_ENV=testnet
DATABASE_URL=mysql+aiomysql://username:password@127.0.0.1:3306/legal_mediverse
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
WEB3_PROVIDER_URL=https://rpc-amoy.polygon.technology
ESCROW_CONTRACT_ADDRESS=REPLACE_WITH_VERIFIED_AMOY_CONTRACT_ADDRESS
ESCROW_ORACLE_ADDRESS=REPLACE_WITH_AUTHORIZED_ORACLE_ADDRESS
OBJECT_STORAGE_PROVIDER=s3
S3_BUCKET=REPLACE_WITH_TESTNET_BUCKET
S3_ENDPOINT=
S3_REGION=
